    <Include file="LibDeflate\lib.xml"/>
    <!-- Guild Sync outbound pacing only — not the rest of AceComm-3.0 (Guild
         Sync receives via direct CHAT_MSG_ADDON, not AceComm:RegisterComm).
         Blizzard silently drops addon messages sent faster than its own
         internal rate limit allows; ChatThrottleLib queues and paces sends
         to stay under that limit instead of losing them. See GuildSync.lua's
         SendRawMessage for why this was re-added after being removed in
         v0.9.12-beta. -->
    <Script file="AceComm-3.0\ChatThrottleLib.lua"/>
